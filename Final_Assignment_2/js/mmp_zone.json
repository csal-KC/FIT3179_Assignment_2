{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/mmp_zone_2025.csv"
  },
  "width": 650,
  "height": 235,
  "title": {
    "text": "10  Which reef zones have more coral cover?",
    "subtitle": "MMP modelled hard coral cover, 2025; selected zones",
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 11
  },
  "config": {
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "gridColor": "#e7efed"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#D48B55",
        "strokeWidth": 3,
        "color": "#177F83"
      },
      "encoding": {
        "y": {
          "field": "reef_zone",
          "type": "nominal",
          "sort": {
            "field": "MEAN_COVER",
            "order": "descending"
          },
          "title": "Reef zone"
        },
        "x": {
          "field": "MEAN_COVER",
          "type": "quantitative",
          "title": "Mean modelled hard coral cover (%)",
          "scale": {
            "domain": [
              0,
              40
            ]
          }
        },
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 190,
        "color": "#177F83",
        "stroke": "white",
        "strokeWidth": 1.3
      },
      "encoding": {
        "y": {
          "field": "reef_zone",
          "type": "nominal",
          "sort": {
            "field": "MEAN_COVER",
            "order": "descending"
          },
          "title": "Reef zone"
        },
        "x": {
          "field": "MEAN_COVER",
          "type": "quantitative",
          "title": "Mean modelled hard coral cover (%)",
          "scale": {
            "domain": [
              0,
              40
            ]
          }
        },
        "tooltip": [
          {
            "field": "reef_zone",
            "type": "nominal",
            "title": "Zone"
          },
          {
            "field": "MEAN_COVER",
            "type": "quantitative",
            "title": "Cover (%)",
            "format": ".1f"
          },
          {
            "field": "SERIES",
            "type": "quantitative",
            "title": "Monitoring Series"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 12,
        "color": "#177F83"
      },
      "encoding": {
        "y": {
          "field": "reef_zone",
          "type": "nominal",
          "sort": {
            "field": "MEAN_COVER",
            "order": "descending"
          },
          "title": "Reef zone"
        },
        "x": {
          "field": "MEAN_COVER",
          "type": "quantitative",
          "title": "Mean modelled hard coral cover (%)",
          "scale": {
            "domain": [
              0,
              40
            ]
          }
        },
        "text": {
          "field": "MEAN_COVER",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ]
}
