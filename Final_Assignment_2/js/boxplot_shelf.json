{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/boxplot_summary.csv"
  },
  "width": 650,
  "height": 310,
  "title": {
    "text": "06  How variable is coral cover across reef shelves?",
    "subtitle": "LTMP reef-level means, 2022–23",
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 11
  },
  "config": {
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "gridColor": "#e7efed"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#25373B",
        "strokeWidth": 1.6
      },
