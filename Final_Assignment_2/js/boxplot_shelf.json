        "x": {
          "field": "SHELF_NAME",
          "type": "nominal",
          "title": "Reef shelf",
          "sort": [
            "Inshore",
            "Mid-shelf",
            "Outer Shelf"
          ]
        },
        "y": {
          "field": "LOWER",
          "type": "quantitative",
          "title": "Mean hard coral cover (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "y2": {
          "field": "UPPER"
        },
        "tooltip": [
          {
            "field": "SHELF_NAME",
            "title": "Reef Shelf"
          },
          {
            "field": "MEDIAN",
            "title": "Median Cover (%)",
            "format": ".1f"
          },
          {
            "field": "Q1",
